<Window x:Class="Obuv.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Obuv"
        mc:Ignorable="d"
        Title="ОБУВЬ - Авторизация" Height="450" Width="550" FontFamily="Times New Roman" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFFFFF" Icon="/Images/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Background="#7FFF00" BorderThickness="1" Margin="0">
                <TextBlock Text="Авторизация" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Логин" FontSize="18" Margin="80,50,0,15"/>
                <TextBox Width="385" Height="30" x:Name="LoginBox"/>
                <TextBlock Text="Пароль" FontSize="18" Margin="80,15,0,15"/>
                <PasswordBox Width="385" Height="30" x:Name="PassBox"/>
                <Button Content="Войти" Width="385" Height="35" Margin="0,15,0,0" Background="#00FA9A" IsDefault="True" Click="Button_Click"/>
                <Button Content="Войти как гость" Width="385" Height="35" Margin="0,15,0,0" Background="#00FA9A" Click="Button_Click_1"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
