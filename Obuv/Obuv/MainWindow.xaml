<Window x:Class="Obuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Obuv"
        mc:Ignorable="d"
        Title="ОБУВЬ - Страница просмотра товара"
        Height="650"
        Width="1050"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Icon="/Images/Icon.ico"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        MinWidth="700">

    <Window.Resources>
        <DataTemplate x:Key="ProductTemplate">
            <Border BorderBrush="#7FFF00"
                    BorderThickness="1"
                    Background="{Binding RowBackground}"
                    Margin="5"
                    Padding="5">

                <Grid MouseLeftButtonUp="ProductsList_MouseLeftButtonUp"
                      Cursor="{Binding CardCursor}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="{Binding Photo}"
                           Width="150"
                           Height="150"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="5"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                Margin="10,5">

                        <TextBlock Text="{Binding CategoryAndName}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding DescriptionText}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding ManufacturerName}"
                                   FontSize="15"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding ProviderName}"
                                   FontSize="15"
                                   Margin="0,0,0,3"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,3">
                            <TextBlock Text="Цена: "
                                       FontSize="15"/>
                            <TextBlock Text="{Binding OriginalPrice}"
                                       FontSize="15"
                                       Foreground="Red"
                                       TextDecorations="Strikethrough"
                                       Visibility="{Binding HasDiscountVisibility}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FinalPrice}"
                                       FontSize="15"
                                       Foreground="Black"/>
                        </StackPanel>

                        <TextBlock Text="{Binding UnitText}"
                                   FontSize="15"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding StockQuantityText}"
                                   FontSize="15"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="5">

                        <TextBlock Text="Действующая скидка"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding DiscountText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>

                        <Button Content="Удалить"
                                Visibility="{Binding DeleteButtonVisibility}"
                                Background="#00FA9A"
                                FontSize="14"
                                Padding="12,4"
                                Margin="0,12,0,0"
                                Click="DeleteProductButton_Click"/>

                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="60px"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Image Source="/Images/Icon.png"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           Width="40"
                           Height="40"
                           Margin="10,0,0,0"/>

                    <TextBlock Text="ООО ОБУВЬ"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               FontSize="18"
                               FontWeight="Bold"/>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <TextBlock x:Name="UserNameBlock"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0,0,15,0"/>

                    <Button x:Name="LogoutButton"
                            Content="Выход"
                            Height="30"
                            Padding="14,0"
                            FontSize="14"
                            Background="#00FA9A"
                            Click="LogoutButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="Filter">

            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center"
                       Margin="10,8">

                <TextBlock Text="Поиск: "
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,2,0,2"/>

                <TextBox x:Name="SearchBox"
                         Height="28"
                         Width="180"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,2,10,2"
                         ToolTip="Поиск по всем текстовым полям (можно вводить несколько слов)"
                         TextChanged="SearchBox_TextChanged"/>

                <TextBlock Text="Поставщик: "
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,2,0,2"/>

                <ComboBox x:Name="ProvidersBox"
                          Width="165"
                          Height="28"
                          FontSize="14"
                          VerticalContentAlignment="Center"
                          Margin="0,2,10,2"
                          SelectionChanged="ProvidersBox_SelectionChanged"/>

                <TextBlock Text="Сортировка: "
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,2,0,2"/>

                <ComboBox x:Name="SortBox"
                          Width="205"
                          Height="28"
                          FontSize="14"
                          VerticalContentAlignment="Center"
                          Margin="0,2,10,2"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Кол-во на складе (по возрастанию)"/>
                    <ComboBoxItem Content="Кол-во на складе (по убыванию)"/>
                </ComboBox>

                <Button Content="Сбросить"
                        Height="28"
                        FontSize="14"
                        Margin="0,2,10,2"
                        Padding="10,0"
                        Click="ResetFilters_Click"/>

                <Button x:Name="AddProductButton"
                        Content="Добавить товар"
                        Height="28"
                        FontSize="14"
                        Margin="0,2,10,2"
                        Padding="12,0"
                        Background="#00FA9A"
                        Click="AddProductButton_Click"/>

                <Button x:Name="OrdersButton"
                        Content="Заказы"
                        Height="28"
                        FontSize="14"
                        Margin="0,2,0,2"
                        Padding="12,0"
                        Background="#00FA9A"
                        Click="OrdersButton_Click"/>

            </WrapPanel>
        </Grid>

        <Grid Grid.Row="2">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Margin="5">

                <ItemsControl x:Name="ProductsList"
                              ItemTemplate="{StaticResource ProductTemplate}"/>

            </ScrollViewer>

            <TextBlock x:Name="EmptyListBlock"
                       Text="Товары не найдены"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

        </Grid>

    </Grid>
</Window>
