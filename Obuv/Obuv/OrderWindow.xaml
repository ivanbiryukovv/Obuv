<Window x:Class="Obuv.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Obuv"
        mc:Ignorable="d"
        Title="ОБУВЬ - Редактирование заказа"
        Height="640"
        Width="760"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Icon="/Images/Icon.ico"
        WindowStartupLocation="CenterScreen"
        MinHeight="500"
        MinWidth="620">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/Icon.png"
                           Stretch="Uniform"
                           Width="40"
                           Height="40"
                           Margin="10,0,0,0"/>
                    <TextBlock x:Name="HeaderTitleBlock"
                               Text="Заказ"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Назад"
                        Height="30"
                        Padding="14,0"
                        Margin="0,0,10,0"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Background="#00FA9A"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15">
            <StackPanel Orientation="Vertical">

                <StackPanel x:Name="OrderIdPanel" Orientation="Vertical" Margin="0,0,0,10">
                    <TextBlock Text="Номер заказа (ID):" FontSize="15" Margin="0,0,0,3"/>
                    <TextBox x:Name="OrderIdBox"
                             Height="28"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Background="#F0F0F0"/>
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Статус заказа:" FontSize="15" Margin="0,0,0,3"/>
                        <ComboBox x:Name="StatusBox"
                                  Height="28"
                                  FontSize="14"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Новый"/>
                            <ComboBoxItem Content="Завершен"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Код для получения:" FontSize="15" Margin="0,0,0,3"/>
                        <TextBox x:Name="CodeBox"
                                 Height="28"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Клиент:" FontSize="15" Margin="0,0,0,3"/>
                <ComboBox x:Name="UserBox"
                          Height="28"
                          FontSize="14"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Адрес пункта выдачи:" FontSize="15" Margin="0,0,0,3"/>
                <ComboBox x:Name="PickupPointBox"
                          Height="28"
                          FontSize="14"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата заказа:" FontSize="15" Margin="0,0,0,3"/>
                        <DatePicker x:Name="OrderDatePicker"
                                    Height="28"
                                    FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата доставки:" FontSize="15" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DeliveryDatePicker"
                                    Height="28"
                                    FontSize="14"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Состав заказа:" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ProductSelectBox"
                              Grid.Column="0"
                              Height="28"
                              FontSize="14"
                              VerticalContentAlignment="Center"/>

                    <TextBox x:Name="ItemCountBox"
                             Grid.Column="2"
                             Height="28"
                             FontSize="14"
                             Text="1"
                             VerticalContentAlignment="Center"
                             ToolTip="Количество товара"/>

                    <Button Grid.Column="4"
                            Content="Добавить товар"
                            Height="28"
                            Padding="12,0"
                            FontSize="14"
                            Background="#00FA9A"
                            Click="AddItemButton_Click"/>
                </Grid>

                <Border BorderBrush="#7FFF00" BorderThickness="1" MinHeight="120" Padding="5">
                    <ItemsControl x:Name="OrderItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayText}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                            Content="Убрать"
                                            Padding="10,2"
                                            FontSize="13"
                                            Click="RemoveItemButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#7FFF00" BorderThickness="0,1,0,0" Background="#FFFFFF">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="15,0">

                <Button x:Name="DeleteButton"
                        Content="Удалить заказ"
                        Height="34"
                        Padding="16,0"
                        FontSize="14"
                        Margin="0,0,10,0"
                        Click="DeleteButton_Click"/>

                <Button Content="Сохранить"
                        Height="34"
                        Padding="20,0"
                        FontSize="14"
                        Background="#00FA9A"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Отмена"
                        Height="34"
                        Padding="16,0"
                        FontSize="14"
                        Click="BackButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
