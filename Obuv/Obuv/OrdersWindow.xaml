<Window x:Class="Obuv.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Obuv"
        mc:Ignorable="d"
        Title="ОБУВЬ - Список заказов"
        Height="620"
        Width="980"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Icon="/Images/Icon.ico"
        WindowStartupLocation="CenterScreen"
        MinHeight="400"
        MinWidth="650">

    <Window.Resources>
        <DataTemplate x:Key="OrderTemplate">
            <Border BorderBrush="#7FFF00"
                    BorderThickness="1"
                    Background="#FFFFFF"
                    Margin="5"
                    Padding="10">

                <Grid MouseLeftButtonUp="OrdersList_MouseLeftButtonUp"
                      Cursor="{Binding CardCursor}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5,0">
                        <TextBlock Text="{Binding OrderTitle}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding ArticlesText}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="15"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding ClientNameText}"
                                   FontSize="15"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding PickupPointText}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding OrderDateText}"
                                   FontSize="15"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{Binding CodeText}"
                                   FontSize="15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="Дата доставки"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding DeliveryDateText}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>

                        <Button Content="Удалить"
                                Visibility="{Binding DeleteButtonVisibility}"
                                Background="#00FA9A"
                                FontSize="14"
                                Padding="12,4"
                                Margin="0,12,0,0"
                                Click="DeleteOrderButton_Click"/>

                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/Icon.png"
                           Stretch="Uniform"
                           Width="40"
                           Height="40"
                           Margin="10,0,0,0"/>
                    <TextBlock Text="ООО ОБУВЬ — Заказы"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock x:Name="UserNameBlock"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0,0,15,0"/>
                    <Button Content="Назад"
                            Height="30"
                            Padding="14,0"
                            FontSize="14"
                            Background="#00FA9A"
                            Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    x:Name="AdminActionsPanel"
                    Orientation="Horizontal"
                    Margin="10,8">
            <Button x:Name="AddOrderButton"
                    Content="Добавить заказ"
                    Height="30"
                    Padding="14,0"
                    FontSize="14"
                    Background="#00FA9A"
                    Click="AddOrderButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                <ItemsControl x:Name="OrdersList"
                              ItemTemplate="{StaticResource OrderTemplate}"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyOrdersBlock"
                       Text="Заказы не найдены"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
