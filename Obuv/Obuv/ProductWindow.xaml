<Window x:Class="Obuv.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Obuv"
        mc:Ignorable="d"
        Title="ОБУВЬ - Редактирование товара"
        Height="640"
        Width="780"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Icon="/Images/Icon.ico"
        WindowStartupLocation="CenterScreen"
        MinHeight="500"
        MinWidth="650">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/Icon.png"
                           Stretch="Uniform"
                           Width="40"
                           Height="40"
                           Margin="10,0,0,0"/>
                    <TextBlock x:Name="HeaderTitleBlock"
                               Text="Товар"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Назад"
                        Height="30"
                        Padding="14,0"
                        Margin="0,0,10,0"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Background="#00FA9A"
                        Click="BackButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,20,0">
                    <Border BorderBrush="#7FFF00"
                            BorderThickness="1"
                            Width="230"
                            Height="180"
                            Background="#FFFFFF">
                        <Image x:Name="ProductImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="5"/>
                    </Border>

                    <Button Content="Выбрать фото"
                            Height="32"
                            FontSize="14"
                            Margin="0,12,0,0"
                            Background="#00FA9A"
                            Click="SelectPhotoButton_Click"/>

                    <Button Content="Убрать фото"
                            Height="28"
                            FontSize="14"
                            Margin="0,8,0,0"
                            Click="ClearPhotoButton_Click"/>

                    <TextBlock Text="Изображение сохраняется в папку с ограничением 300x200 пикс."
                               FontSize="12"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical">

                    <StackPanel x:Name="IdPanel" Orientation="Vertical" Margin="0,0,0,10">
                        <TextBlock Text="ID товара (Артикул):" FontSize="15" Margin="0,0,0,3"/>
                        <TextBox x:Name="ArticleBox"
                                 Height="28"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Background="#F0F0F0"/>
                    </StackPanel>

                    <TextBlock Text="Наименование товара:" FontSize="15" Margin="0,0,0,3"/>
                    <TextBox x:Name="NameBox"
                             Height="28"
                             FontSize="14"
                             MaxLength="255"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Категория товара:" FontSize="15" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CategoryBox"
                              Height="28"
                              FontSize="14"
                              VerticalContentAlignment="Center"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Производитель:" FontSize="15" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ManufacturerBox"
                              Height="28"
                              FontSize="14"
                              VerticalContentAlignment="Center"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Поставщик:" FontSize="15" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ProviderBox"
                              Height="28"
                              FontSize="14"
                              VerticalContentAlignment="Center"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Цена (руб.):" FontSize="15" Margin="0,0,0,3"/>
                            <TextBox x:Name="PriceBox"
                                     Height="28"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Например: 2500 или 2500.50 (не более 2 знаков после запятой)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Единица измерения:" FontSize="15" Margin="0,0,0,3"/>
                            <TextBox x:Name="UnitBox"
                                     Height="28"
                                     FontSize="14"
                                     MaxLength="255"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Количество на складе:" FontSize="15" Margin="0,0,0,3"/>
                            <TextBox x:Name="StockBox"
                                     Height="28"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Действующая скидка (%):" FontSize="15" Margin="0,0,0,3"/>
                            <TextBox x:Name="DiscountBox"
                                     Height="28"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Описание товара:" FontSize="15" Margin="0,0,0,3"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="75"
                             FontSize="14"
                             MaxLength="255"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#7FFF00" BorderThickness="0,1,0,0" Background="#FFFFFF">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="15,0">

                <Button x:Name="DeleteButton"
                        Content="Удалить товар"
                        Height="34"
                        Padding="16,0"
                        FontSize="14"
                        Margin="0,0,10,0"
                        Click="DeleteButton_Click"/>

                <Button Content="Сохранить"
                        Height="34"
                        Padding="20,0"
                        FontSize="14"
                        Background="#00FA9A"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Отмена"
                        Height="34"
                        Padding="16,0"
                        FontSize="14"
                        Click="BackButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
